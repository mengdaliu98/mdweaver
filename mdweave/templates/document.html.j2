{#- The per-row controls: create, import, rename, delete.

    Rendered on every row and revealed on hover or focus, so the thing you want
    to act on is the thing you are pointing at -- and so they stay in the tab
    order rather than hiding behind a gesture a keyboard cannot make. filetree.js
    unhides the set once it knows a server is listening; over `file://` there is
    nothing to write to. -#}
{% macro row_actions(what, label) %}
{% set where = "in" if what == "folder" else "beside" %}
              <span class="tree__actions">
                <button class="tree__action" type="button" data-action="create"
                        title="New document" aria-label="New document {{ where }} {{ label }}">
                  <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 2.5v9M2.5 7h9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </button>
                <button class="tree__action" type="button" data-action="import"
                        title="Import a .md file" aria-label="Import a markdown file {{ where }} {{ label }}">
                  {# Arrow up out of a tray: the file goes in, so it is an
                     upload. Down into a tray reads as a download, which is
                     the opposite of what this button does. #}
                  <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 8.5V2.1M4.4 4.7 7 2.1l2.6 2.6M2.4 9.4v1.6h9.2V9.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
{% if what == "file" %}
                <button class="tree__action" type="button" data-action="rename"
                        title="Rename" aria-label="Rename {{ label }}">
                  <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M9.4 2.3 11.7 4.6 5.3 11H3v-2.3z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
                </button>
                <button class="tree__action tree__action--danger" type="button" data-action="delete"
                        title="Delete" aria-label="Delete {{ label }}">
                  <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2.8 4h8.4M5.6 4V2.6h2.8V4M4 4l.5 7.4h5L10 4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
{% endif %}
              </span>
{% endmacro %}
{#- Recursive: a folder renders its children through the same macro. `path` is
    the folder this list sits in, `""` at the root -- the key the arrangement is
    stored under, and what a drop needs to know to say where it landed. -#}
{% macro tree_list(nodes, prefix, active, depth, path) %}
      <ul class="tree" role="group" data-path="{{ path }}">
{% for node in nodes %}
{% if node.is_dir %}
        <li class="tree__item">
          <details class="tree__folder" data-folder="{{ node.name }}"
                   data-path="{{ path }}{% if path %}/{% endif %}{{ node.name }}" open>
            <summary class="tree__row tree__row--folder" style="--depth: {{ depth }}">
              <svg class="tree__chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2.5 8 6l-4 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="tree__label">{{ node.label }}</span>
{{ row_actions("folder", node.label) }}
            </summary>
            {{ tree_list(node.children, prefix, active, depth + 1, path ~ ("/" if path else "") ~ node.name) }}
          </details>
        </li>
{% else %}
        {# The row is a link, and a link may not contain a button, so the
           controls are a sibling laid over its right-hand end. #}
        <li class="tree__item">
          <div class="tree__file">
            <a class="tree__row tree__row--file{% if node.doc_id == active %} tree__row--active{% endif %}"
               style="--depth: {{ depth }}"
               href="{{ prefix }}{{ node.doc_id }}.html"
               draggable="true"
               data-doc="{{ node.doc_id }}" data-name="{{ node.name }}" data-parent="{{ path }}"
               {% if node.doc_id == active %}aria-current="page"{% endif %}>
              <svg class="tree__icon" viewBox="0 0 14 14" aria-hidden="true"><path d="M3.5 1.5h4.2L11 4.8v7.7H3.5z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M7.6 1.7v3.2h3.2" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
              <span class="tree__label">{{ node.label }}</span>
            </a>
{{ row_actions("file", node.label) }}
          </div>
        </li>
{% endif %}
{% endfor %}
      </ul>
{% endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{% for href in css_hrefs %}
<link rel="stylesheet" href="{{ href }}">
{% endfor %}
</head>
<body data-document="{{ doc_id }}" data-prefix="{{ prefix }}">
<div class="shell">

  <nav class="sidebar" id="sidebar" aria-label="Documents">
    <div class="sidebar__head">
      <span class="sidebar__title">Documents</span>
      <span class="sidebar__actions">
        {# Shared by every row's import button: which folder it lands in is
           whichever row was clicked, not a property of the picker. #}
        <input type="file" id="sidebar-file" accept=".md,text/markdown" multiple hidden>
        <button class="sidebar__collapse" type="button" id="sidebar-collapse"
                title="Hide sidebar" aria-label="Hide sidebar" aria-expanded="true">
          <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M9 3 5 7l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </span>
    </div>
    <div class="sidebar__dropzone" aria-hidden="true"><span>Drop .md files to import</span></div>
{% if tree %}
    {{ tree_list(tree, prefix, doc_id, 0, "") }}
{% else %}
    <p class="sidebar__empty">No documents found.</p>
{% endif %}
    {# The rest of the panel. A drop that lands here means "the top level",
       which is the only way to get a document back out of a folder. #}
    <div class="sidebar__root" id="sidebar-root" data-path=""></div>
  </nav>

  {# Drag to set the panel width. A separator rather than a button: it has a
     value along one axis, which is also why the arrow keys work on it. #}
  <div class="sidebar-resize" id="sidebar-resize" role="separator"
       aria-orientation="vertical" aria-label="Resize sidebar" tabindex="0"></div>

  <button class="sidebar-show" type="button" id="sidebar-show"
          title="Show sidebar" aria-label="Show sidebar" hidden>
    <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M5 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>

  {# Page-level actions. Hidden until the server answers, like every other
     control that reaches back to it. #}
  <div class="page-actions">
    <button class="page-action page-action--icon" type="button" id="refresh"
            title="Reload this document from disk" aria-label="Refresh" hidden>
      <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M11.95 8.75a5.25 5.25 0 1 1-1.24-5.46l2.71 2.54M13.42 2.33v3.5h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="page-action" type="button" id="checkpoint"
            title="Commit and push this document" hidden>
      <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1.8v10.4M2.6 6.2 7 1.8l4.4 4.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Checkpoint</span>
    </button>
  </div>

  <dialog class="checkpoint-dialog" id="checkpoint-dialog" aria-labelledby="checkpoint-title">
    <form method="dialog" id="checkpoint-form">
      <h2 class="checkpoint-dialog__title" id="checkpoint-title">Checkpoint this document</h2>
      <p class="checkpoint-dialog__what" id="checkpoint-what"></p>
      <textarea class="checkpoint-dialog__message" id="checkpoint-message" rows="3"
                placeholder="What changed?" aria-label="Commit message"></textarea>
      <p class="checkpoint-dialog__error" id="checkpoint-error" hidden></p>
      <div class="checkpoint-dialog__actions">
        <button type="button" class="checkpoint-dialog__cancel" id="checkpoint-cancel">Cancel</button>
        <button type="submit" class="checkpoint-dialog__submit" id="checkpoint-submit">Commit and push</button>
      </div>
    </form>
  </dialog>

  <main class="main">
    <div class="page">
      <article class="doc" id="doc">
{{ body | safe }}
      </article>

      <aside class="notes-layer" id="notes-layer" aria-label="Comments">
{% for note in notes %}
        {# `status` is a data attribute, not a class: `note--open` is reserved
           for the expanded/collapsed UI state that notes.js toggles. #}
        <div class="note note--{{ note.color_token }}"
             id="note-{{ note.dom_id }}"
             data-ann="{{ note.id }}"
             data-status="{{ note.status }}"
{% if note.offset %}
             data-dx="{{ note.offset.dx }}" data-dy="{{ note.offset.dy }}"
{% endif %}
             {% if note.custom_color %}style="--note-custom: {{ note.custom_color }};"{% endif %}>
          <button class="note__pin" type="button"
                  aria-expanded="false"
                  aria-controls="note-body-{{ note.dom_id }}"
                  title="{{ note.quote }}">
            <span class="note__initial" aria-hidden="true">{{ note.initial }}</span>
            <span class="sr-only">Comment on “{{ note.quote }}”</span>
          </button>
          <div class="note__body" id="note-body-{{ note.dom_id }}" role="region">
            <blockquote class="note__quote">{{ note.quote }}</blockquote>
{% for entry in note.thread %}
            <div class="note__entry">
              <div class="note__meta">
                <span class="note__author">{{ entry.author }}</span>
                {% if entry.at %}<time class="note__date">{{ entry.at }}</time>{% endif %}
              </div>
              <p class="note__text">{{ entry.body }}</p>
            </div>
{% endfor %}
{% if note.tags %}
            <div class="note__tags">
{% for tag in note.tags %}
              <span class="note__tag">{{ tag }}</span>
{% endfor %}
            </div>
{% endif %}
          </div>
        </div>
{% endfor %}
      </aside>
    </div>
  </main>

</div>
{% for src in js_srcs %}
<script src="{{ src }}" defer></script>
{% endfor %}
</body>
</html>
