{#- The per-row controls: new document, new folder, import, rename, delete.

    Rendered on every row and revealed on hover or focus, so the thing you want
    to act on is the thing you are pointing at -- and so they stay in the tab
    order rather than hiding behind a gesture a keyboard cannot make. filetree.js
    unhides the set once it knows a server is listening; over `file://` there is
    nothing to write to.

    A folder's buttons act inside it, a file's beside it, and the root strip
    below the tree carries the same set for the top level -- which is the only
    way to make the first folder in a knowledge base that has none. -#}
{% macro row_actions(what, label) %}
{% set where = "in" if what != "file" else "beside" %}
              <span class="tree__actions">
{% if what != "file" %}
                <button class="tree__action" type="button" data-action="create"
                        title="New document" aria-label="New document {{ where }} {{ label }}">
                  <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 2.5v9M2.5 7h9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </button>
                <button class="tree__action" type="button" data-action="new-folder"
                        title="New folder" aria-label="New folder {{ where }} {{ label }}">
                  {# A folder outline with a plus in it, so it reads as "another
                     one of these" rather than as another new-document button. #}
                  <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1.6 11.2V3.4h3.6l1.2 1.5h6v6.3z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M7 6.9v3M5.5 8.4h3" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                </button>
                <button class="tree__action" type="button" data-action="import"
                        title="Import a .md file" aria-label="Import a markdown file {{ where }} {{ label }}">
                  {# Arrow down into a tray: a file from somewhere else drops
                     into this folder. It used to point up, on the reasoning
                     that the browser uploads the file -- but nobody reading
                     the panel is thinking about the request, they are
                     thinking about the document arriving here, and an up
                     arrow beside a folder reads as taking something out of
                     it. The tray, the stroke weight and the 14x14 box are
                     unchanged, so it still matches its four neighbours. #}
                  <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 2.1V8.5M4.4 5.9 7 8.5l2.6-2.6M2.4 9.4v1.6h9.2V9.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
{% endif %}
{% if what != "root" %}
                <button class="tree__action" type="button"
                        data-action="{{ "rename" if what == "file" else "rename-folder" }}"
                        title="Rename" aria-label="Rename {{ label }}">
                  <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M9.4 2.3 11.7 4.6 5.3 11H3v-2.3z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
                </button>
                <button class="tree__action tree__action--danger" type="button"
                        data-action="{{ "delete" if what == "file" else "delete-folder" }}"
                        title="Delete" aria-label="Delete {{ label }}">
                  <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2.8 4h8.4M5.6 4V2.6h2.8V4M4 4l.5 7.4h5L10 4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
{% endif %}
              </span>
{% endmacro %}
{#- Recursive: a folder renders its children through the same macro. `path` is
    the folder this list sits in, `""` at the root -- the key the arrangement is
    stored under, and what a drop needs to know to say where it landed. -#}
{% macro tree_list(nodes, prefix, active, depth, path) %}
      <ul class="tree" role="group" data-path="{{ path }}">
{% for node in nodes %}
{% if node.is_dir %}
        <li class="tree__item">
          <details class="tree__folder" data-folder="{{ node.name }}"
                   data-path="{{ path }}{% if path %}/{% endif %}{{ node.name }}" open>
            <summary class="tree__row tree__row--folder" style="--depth: {{ depth }}"
                     draggable="true" data-name="{{ node.name }}" data-parent="{{ path }}">
              <svg class="tree__chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2.5 8 6l-4 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="tree__label">{{ node.label }}</span>
{{ row_actions("folder", node.label) }}
            </summary>
            {{ tree_list(node.children, prefix, active, depth + 1, path ~ ("/" if path else "") ~ node.name) }}
          </details>
        </li>
{% else %}
        {# The row is a link, and a link may not contain a button, so the
           controls are a sibling laid over its right-hand end. #}
        <li class="tree__item">
          <div class="tree__file">
            <a class="tree__row tree__row--file{% if node.doc_id == active %} tree__row--active{% endif %}"
               style="--depth: {{ depth }}"
               href="{{ prefix }}{{ node.doc_id }}.html"
               draggable="true"
               data-doc="{{ node.doc_id }}" data-name="{{ node.name }}" data-parent="{{ path }}"
               {% if node.doc_id == active %}aria-current="page"{% endif %}>
              <svg class="tree__icon" viewBox="0 0 14 14" aria-hidden="true"><path d="M3.5 1.5h4.2L11 4.8v7.7H3.5z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M7.6 1.7v3.2h3.2" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
              <span class="tree__label">{{ node.label }}</span>
            </a>
{{ row_actions("file", node.label) }}
          </div>
        </li>
{% endif %}
{% endfor %}
      </ul>
{% endmacro %}


{#- The whole panel, wrapped in markers.

    Rendered on its own as well as inside a page: a change to the tree -- a new
    document, a rename, a drag -- alters the navigation on every page while
    leaving all of their prose untouched, and re-parsing 26 markdown files to
    move one row took two seconds. `splice_sidebar` swaps the region between
    these markers instead, so the cost is one small template render per page.

    The macro emits the markers itself, so the fragment written into a page is
    byte-for-byte the region a later splice will look for. -#}
{% macro sidebar(tree, prefix, active) %}
<!--mdweave:sidebar-->
  <nav class="sidebar" id="sidebar" aria-label="Documents">
    <div class="sidebar__head">
      <span class="sidebar__title">Documents</span>
      <span class="sidebar__actions" data-path="">
        {# Shared by every row's import button: which folder it lands in is
           whichever row was clicked, not a property of the picker. #}
        <input type="file" id="sidebar-file" accept=".md,text/markdown" multiple hidden>
{{ row_actions("root", "the top level") }}
        {# Take what another machine has written. Hidden until the server says
           these documents came from a remote at all -- pulling from nowhere
           is not an idea. Distinct from the refresh beside Checkpoint, which
           re-renders *this page* from the disk it already has; this one goes
           and gets the disk. #}
        <button class="tree__action" type="button" id="sidebar-pull"
                data-action="pull" title="Pull the latest from the remote"
                aria-label="Pull the latest from the remote" hidden>
          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                  d="M13.3 7.2a5.4 5.4 0 1 1-1.6-3.4"/>
            <path fill="currentColor" d="M13.9 1.9v4.2H9.7z"/>
          </svg>
        </button>
        {# Settings sits with the row controls but is not one of them: it acts
           on the whole knowledge base rather than on a folder, which is why it
           is last, next to the panel's own control rather than among the four
           that write files. #}
        <button class="tree__action" type="button" id="sidebar-settings"
                data-action="settings" title="Settings" aria-label="Settings"
                aria-haspopup="dialog" aria-expanded="false">
          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
            <path fill="currentColor" d="M8 5.6A2.4 2.4 0 1 0 8 10.4 2.4 2.4 0 0 0 8 5.6Zm0 3.9a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Z"/>
            <path fill="currentColor" d="m13.9 9.2-.9-.5a5.4 5.4 0 0 0 0-1.4l.9-.5a.6.6 0 0 0 .2-.8l-1-1.7a.6.6 0 0 0-.7-.3l-1 .3a5.3 5.3 0 0 0-1.2-.7l-.1-1a.6.6 0 0 0-.6-.6H7.5a.6.6 0 0 0-.6.5l-.1 1.1c-.5.2-.9.4-1.2.7l-1-.3a.6.6 0 0 0-.7.3l-1 1.7a.6.6 0 0 0 .2.8l.9.5a5.4 5.4 0 0 0 0 1.4l-.9.5a.6.6 0 0 0-.2.8l1 1.7c.2.3.5.4.7.3l1-.3c.3.3.7.5 1.2.7l.1 1c0 .3.3.6.6.6h2a.6.6 0 0 0 .6-.5l.1-1.1c.5-.2.9-.4 1.2-.7l1 .3c.3.1.6 0 .7-.3l1-1.7a.6.6 0 0 0-.2-.8Zm-1.7 2-.8-.2a.6.6 0 0 0-.6.1c-.3.3-.8.6-1.3.8a.6.6 0 0 0-.4.5l-.1.9H8l-.1-.9a.6.6 0 0 0-.4-.5 4 4 0 0 1-1.3-.8.6.6 0 0 0-.6-.1l-.8.2-.5-.9.8-.4a.6.6 0 0 0 .3-.6 4.2 4.2 0 0 1 0-1.5.6.6 0 0 0-.3-.6l-.8-.4.5-.9.8.2a.6.6 0 0 0 .6-.1c.4-.4.8-.6 1.3-.8a.6.6 0 0 0 .4-.5l.1-.9h1l.1.9c0 .3.2.5.4.5.5.2 1 .5 1.3.8.2.2.4.2.6.1l.8-.2.5.9-.8.4a.6.6 0 0 0-.3.6 4.2 4.2 0 0 1 0 1.5c0 .2.1.5.3.6l.8.4-.5.9Z"/>
          </svg>
        </button>
        <button class="sidebar__collapse" type="button" id="sidebar-collapse"
                title="Hide sidebar" aria-label="Hide sidebar" aria-expanded="true">
          <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M9 3 5 7l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </span>
    </div>
    <div class="sidebar__dropzone" aria-hidden="true"><span>Drop .md files to import</span></div>
{% if tree %}
    {{ tree_list(tree, prefix, active, 0, "") }}
{% else %}
    <p class="sidebar__empty">No documents found.</p>
{% endif %}
    {# The rest of the panel. A drop that lands here means "the top level",
       which is the only way to get a document back out of a folder -- and its
       controls are the only way to make a folder when there are none yet. #}
    <div class="sidebar__root" id="sidebar-root" data-path=""></div>
  </nav>
<!--/mdweave:sidebar-->
{% endmacro %}
